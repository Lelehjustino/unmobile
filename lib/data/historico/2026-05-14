class Connection {
  // CONSTANTES

  static const String _loadingDialogRoute = 'loading_reconnect_dialog';
  static const Duration _keepAliveInterval = Duration(seconds: 60);
  static const Duration _gracePeriod = Duration(seconds: 10,); // 10 segundos sem mostrar nada ao voltar pro app
  static const Duration _reconnectInterval = Duration(seconds: 3);
  static const int _maxSilentAttempts = 20; // tentativas de reconexão silenciosa

  /// IPs que devem usar ambiente de teste
  static String ipTeste = '192.192.192.192';
  static String ipTeste2 = '192192192192';

  // ESTADO INTERNO

  /// Conexão MySQL ativa
  static MySQLConnection? _conn;

  /// Impede chamadas simultâneas ao processo de conexão.
  /// Quando true, novas chamadas aguardam o resultado da tentativa em curso.
  static bool _isConnecting = false;

  /// Timer de verificação periódica (keep-alive silencioso)
  static Timer? _keepAliveTimer;

  /// Garante no máximo um loop de reconexão silenciosa rodando por vez.
  static bool _estaReconectandoSilencioso = false;

  /// Indica se o app está em segundo plano (paused/inactive).
  static bool _appEmBackground = false;

  /// Se o loading de reconexão está sendo exibido (ou agendado).
  static bool _exibindoCarregamento = false;

  /// PERÍODO DE GRAÇA: ativo nos 10s após o app voltar do background.
  /// Durante esse período, _garantirConexao retorna null imediatamente
  /// sem mostrar loading, sem bloquear UI, sem feedback visual algum.
  static bool _emPeriodoGracia = false;

  /// Completer usado para sinalizar fim de período de graça ou reconexão.
  /// Permite que _garantirConexao aguarde sem polling cego.
  static Completer<void>? _graciaCompleter;

  // ESTADO PÚBLICO (observável)

  /// Estado de conexão observável pelo GetX
  static final RxBool _isConnected = false.obs;
  static RxBool get connectionStatus => _isConnected;

  /// ValueNotifier para widgets que não usam GetX
  static final ValueNotifier<bool> isConnected = ValueNotifier(false);

  /// Sinaliza que o usuário voltou ao app (para uso externo)
  static final ValueNotifier<bool> voltouAoApp = ValueNotifier(false);

  /// Permite zerar atendimento quando necessário
  static final ValueNotifier<bool> zerarAtendimento = ValueNotifier(false);

  /// Navegação bloqueada enquanto aguarda reconexão após voltar ao app
  static final ValueNotifier<bool> navigationLocked = ValueNotifier(false);
  static bool get bloquearNavegacao => navigationLocked.value;

  // LIFECYCLE

  /// Registra o observador de lifecycle. Chamar uma única vez no main.
  static void initLifecycleObserver() {
    WidgetsBinding.instance.addObserver(_LifecycleHandler());
  }

  /// Chamado quando o app vai para background.
  ///
  /// NÃO fecha conexão, NÃO mostra loading, NÃO inicia reconexão.
  /// Apenas sinaliza o estado para que outros métodos pausem operações.
  static void _appFoiParaBackground() {
    _appEmBackground = true;

    // Cancela graça anterior se existia (evita graça "fantasma" ao retornar)
    _encerrarPeriodoGracia();

    navigationLocked.value = true;
    debugPrint('[Connection] App em background – conexão preservada.');
  }

  /// Chamado quando o app volta do background.
  /// Fluxo:
  /// 1) Ativa período de graça de 10s → ZERO feedback visual pode aparecer.
  /// 2) Tenta reconexão imediata silenciosa.
  /// 3) Se reconectar dentro da graça → libera navegação, encerra graça.
  /// 4) Se não reconectar → inicia loop silencioso.
  ///    A graça expira automaticamente após 10s via timer.
  ///    Após expirar: comportamento normal volta — loading pode aparecer
  ///    somente se o usuário tentar uma ação.
  ///
  /// NÃO bloqueia (sem await no completer) para não congelar o lifecycle.
  static void _appVoltouDoBackground() async {
    _appEmBackground = false;
    voltouAoApp.value = true;

    // Inicia novo período de graça de 10s (Completer fresco para esta sessão)
    _iniciarPeriodoGracia();

    debugPrint('[Connection] App voltou – período de graça de 10s iniciado.');

    // Tenta reconexão imediata (silenciosa, sem UI)
    final bool ok = await _tentarConectarSilencioso();

    if (ok) {
      debugPrint('[Connection] Reconexão silenciosa OK dentro da graça.');
      _liberarNavegacao();
      _encerrarPeriodoGracia();
      return;
    }

    // Não reconectou imediatamente → inicia loop silencioso em background.
    //  NÃO aguardamos o completer aqui: isso evita congelamento do lifecycle.
    // A graça expira automaticamente pelo timer em _iniciarPeriodoGracia().
    // _liberarNavegacao() será chamada pelo loop silencioso ao reconectar,
    // ou pelo timer da graça ao expirar.
    _iniciarReconexaoSilenciosa();

    debugPrint(
      '[Connection] Reconexão silenciosa iniciada. '
      'Graça de 10s expira automaticamente pelo timer.',
    );
  }

  /// Inicia o período de graça de 10s e arma o timer de expiração automática.
  ///
  /// Ao expirar sem reconexão:
  /// - Encerra o período de graça
  /// - Libera a navegação (se ainda bloqueada)
  /// - A partir daí, _garantirConexao volta ao comportamento normal (loading)
  static void _iniciarPeriodoGracia() {
    _graciaCompleter = Completer<void>();
    _emPeriodoGracia = true;

    // Timer garante que a graça sempre expira, mesmo sem reconexão.
    // Ao expirar: libera navegação para não deixar o app preso.
    Future.delayed(_gracePeriod, () {
      if (_emPeriodoGracia) {
        debugPrint(
          '[Connection] Período de graça de 10s encerrado automaticamente.',
        );
        _encerrarPeriodoGracia();
        // Libera navegação caso ainda estivesse bloqueada pela graça
        if (navigationLocked.value) {
          _liberarNavegacao();
        }
      }
    });
  }

  /// Encerra o período de graça e completa o Completer (se ainda pendente).
  static void _encerrarPeriodoGracia() {
    _emPeriodoGracia = false;
    if (_graciaCompleter != null && !_graciaCompleter!.isCompleted) {
      _graciaCompleter!.complete();
    }
    _graciaCompleter = null;
  }

  /// Libera a navegação e limpa o sinal de "voltou ao app".
  static void _liberarNavegacao() {
    navigationLocked.value = false;
    voltouAoApp.value = false;
  }

  // PING — VALIDAÇÃO REAL DA CONEXÃO

  /// Valida a conexão com uma query leve.
  /// Retorna false se a conexão não existir, estiver fechada ou timeout.
  /// Valida a conexão com uma query leve.
  /// Retorna false se a conexão não existir, estiver fechada ou timeout.
  /// iOS em Wi-Fi com latência alta pode levar até 1.5s — usando 2s.
  static Future<bool> _ping() async {
    try {
      if (_conn == null || !_conn!.connected) return false;
      await _conn!
          .execute('SELECT 1')
          .timeout(const Duration(milliseconds: 2000)); // 2s: seguro para iOS
      return true;
    } catch (_) {
      return false;
    }
  }

  // CONEXÃO – USO INTERNO

  /// Tenta conectar silenciosamente (sem afetar UI).
  ///
  /// Garante que apenas uma tentativa ocorra por vez:
  /// chamadas concorrentes aguardam o resultado da tentativa em curso.
  static Future<bool> _tentarConectarSilencioso() async {
    // Se já há tentativa em curso, aguarda seu resultado
    if (_isConnecting) {
      while (_isConnecting) {
        await Future.delayed(const Duration(milliseconds: 100));
      }
      return _conn != null && _conn!.connected;
    }

    _isConnecting = true;
    try {
      // Fast path: conexão já ativa?
      if (await _ping()) {
        _setConnectionState(true);
        return true;
      }

      final prefs = await SharedPreferences.getInstance();
      final servidor = prefs.getString('servidor');
      if (servidor == null) return false;

      final bool ok = await _tryConnect(servidor);
      _setConnectionState(ok);

      if (ok) _iniciarKeepAlive();

      return ok;
    } finally {
      _isConnecting = false;
    }
  }

  // CONEXÃO – USO PÚBLICO

  /// Verifica se a conexão realmente caiu (para uso externo).
  static Future<bool> conexaoRealmenteCaiu() async {
    return !(await _ping());
  }

  /// Conecta/verifica conexão. Retorna true se ok.
  static Future<bool> conectarBanco() async {
    return await _tentarConectarSilencioso();
  }

  /// Conecta com reset completo (usado ao salvar configurações ou refresh manual).
  static Future<bool> conectarBanconoSalvar() async {
    voltouAoApp.value = false;
    final prefs = await SharedPreferences.getInstance();
    final servidor = prefs.getString('servidor');
    if (servidor == null) return false;

    await _closeConnSilently();

    _isConnecting = true;
    try {
      final bool ok = await _tryConnect(servidor);
      _setConnectionState(ok);
      if (ok) _iniciarKeepAlive();
      return ok;
    } finally {
      _isConnecting = false;
    }
  }

  // RECONEXÃO EM BACKGROUND (silenciosa, sem loading)

  /// Inicia loop de reconexão silenciosa em background.
  ///
  /// Garantias:
  /// - No máximo 1 loop ativo por vez (_estaReconectandoSilencioso)
  /// - Nunca exibe UI
  /// - Pausa enquanto app está em background (_appEmBackground)
  /// - Ao reconectar: fecha loading (se aberto), libera navegação
  static void _iniciarReconexaoSilenciosa() async {
    if (_estaReconectandoSilencioso) return; // debounce: um loop por vez
    _estaReconectandoSilencioso = true;

    debugPrint('[Connection] Iniciando reconexão silenciosa...');

    int tentativas = 0;

    while (tentativas < _maxSilentAttempts) {
      // Pausa enquanto app está em background para não desperdiçar recursos
      if (_appEmBackground) {
        await Future.delayed(const Duration(seconds: 1));
        continue;
      }

      final bool ok = await _tentarConectarSilencioso();

      if (ok) {
        debugPrint(
          '[Connection] Reconexão silenciosa OK após $tentativas tentativas.',
        );
        _estaReconectandoSilencioso = false;

        // Sinaliza fim do período de graça (se ainda ativo)
        _encerrarPeriodoGracia();

        // Fecha loading apenas se havia sido aberto (usuário tentou ação durante reconexão)
        _fecharLoadingReconexao();

        // Libera navegação se estava bloqueada pelo lifecycle
        if (navigationLocked.value) {
          _liberarNavegacao();
        }

        return;
      }

      tentativas++;
      debugPrint(
        '[Connection] Tentativa silenciosa $tentativas/$_maxSilentAttempts falhou.',
      );
      await Future.delayed(_reconnectInterval);
    }

    debugPrint(
      '[Connection] Reconexão silenciosa encerrada sem sucesso após $_maxSilentAttempts tentativas.',
    );
    _estaReconectandoSilencioso = false;
  }

  // KEEP-ALIVE (verificação periódica silenciosa)

  static void _iniciarKeepAlive() {
    _keepAliveTimer?.cancel();

    _keepAliveTimer = Timer.periodic(_keepAliveInterval, (_) async {
      // Não interfere enquanto app está em background ou em período de graça
      if (_appEmBackground || _emPeriodoGracia) return;

      // KeepAlive só valida silenciosamente — NUNCA altera estado de UI
      final bool ok = await _ping();

      if (!ok) {
        debugPrint(
          '[KeepAlive] Conexão perdida – iniciando reconexão silenciosa.',
        );
        // Não chama _setConnectionState(false) aqui para evitar
        // acionar observers externos desnecessariamente.
        // O estado será atualizado pelo resultado da reconexão silenciosa.
        _iniciarReconexaoSilenciosa();
      }
    });
  }

  // GARANTIR CONEXÃO (chamado antes de qualquer operação no banco)

  /// Garante conexão ativa antes de executar qualquer operação no banco.
  ///
  /// Ordem de decisão (determinística):
  ///
  /// **Passo 1 — Fast path (zero rede):**
  /// Conexão em memória ativa → retorna imediatamente.
  ///
  /// **Passo 2 — Período de graça (10s após voltar do background):**
  ///  NÃO mostra loading.
  ///  NÃO bloqueia a UI.
  ///  NÃO exibe nenhum feedback visual.
  ///  Inicia reconexão silenciosa (se não estiver em andamento).
  ///  Retorna null imediatamente → operação falha silenciosamente.
  ///
  /// **Passo 3 — Conexão perdida + graça encerrada:**
  /// Exibe loading imediatamente e entra em loop de reconexão com feedback visual.
  /// O loop só termina quando reconectar ou o app ir para background.
  static Future<MySQLConnection?> _garantirConexao() async {
    // ── Passo 1: fast path — verificação sem rede ──────────────────────────
    if (_conn != null && _conn!.connected && _isConnected.value) {
      return _conn;
    }

    // ── Passo 2: dentro do período de graça (10s) → silencioso e sem bloqueio
    //
    // GARANTIA CRÍTICA: durante os 10s após voltar do background,
    // absolutamente nenhum feedback visual pode ser gerado.
    // Retornamos null imediatamente para não congelar a UI.
    if (_emPeriodoGracia) {
      debugPrint(
        '[Connection] Ação durante período de graça – retorno silencioso. '
        ' sem loading |  sem erro |  sem bloqueio de UI.',
      );

      // Inicia reconexão silenciosa em background (se não estiver em andamento)
      if (!_estaReconectandoSilencioso) {
        _iniciarReconexaoSilenciosa();
      }

      // Retorna null imediatamente:
      // - O chamador recebe '[]' ou 'erro' silenciosamente
      // - Nenhuma UI é afetada
      // - Nenhuma mensagem é exibida
      return null;
    }

    // ── Passo 3: conexão perdida + graça encerrada → loading + loop ────────
    _setConnectionState(false);
    _mostrarLoadingReconexao();

    while (true) {
      // App foi para background durante a espera → não mantemos o usuário travado
      if (_appEmBackground) {
        // O loading permanece visível; será fechado ao reconectar após voltar.
        return null;
      }

      final bool reconectou = await _tentarConectarSilencioso();

      if (reconectou && _conn != null && _conn!.connected) {
        _fecharLoadingReconexao();
        return _conn;
      }

      await Future.delayed(const Duration(seconds: 2));
    }
  }

  // OPERAÇÕES NO BANCO

  Future<String> select(String sql) async {
    try {
      final conn = await _garantirConexao();
      if (conn == null) return '[]';

      final result = await conn.execute(sql);
      return jsonEncode(result.rows.map((r) => r.assoc()).toList());
    } catch (e) {
      debugPrint('[SELECT] Erro: $e');

      // Verifica se foi queda real de conexão antes de tentar novamente
      if (await conexaoRealmenteCaiu()) {
        await _closeConnSilently();
        _setConnectionState(false);
        _iniciarReconexaoSilenciosa();

        // _garantirConexao já exibirá loading se necessário
        final conn2 = await _garantirConexao();
        if (conn2 != null) {
          try {
            final result = await conn2.execute(sql);
            return jsonEncode(result.rows.map((r) => r.assoc()).toList());
          } catch (_) {}
        }
      }

      return '[]';
    }
  }

  Future<String> ipd(String sql) async {
    try {
      final conn = await _garantirConexao();
      if (conn == null) return 'erro';

      await conn.execute(sql);
      return 'sucesso';
    } catch (e) {
      debugPrint('[IPD] Erro: $e');

      if (await conexaoRealmenteCaiu()) {
        await _closeConnSilently();
        _setConnectionState(false);
        _iniciarReconexaoSilenciosa();

        final conn2 = await _garantirConexao();
        if (conn2 != null) {
          try {
            await conn2.execute(sql);
            return 'sucesso';
          } catch (_) {}
        }
      }

      return 'erro';
    }
  }

  /// Executa múltiplas queries em uma única transação.
  Future<String> transaction(List<String> queries) async {
    try {
      final conn = await _garantirConexao();
      if (conn == null) return 'erro';

      await conn.transactional((ctx) async {
        for (var sql in queries) {
          if (sql.trim().isNotEmpty) {
            await ctx.execute(sql);
          }
        }
      });
      return 'sucesso';
    } catch (e) {
      debugPrint('[TRANSACTION] Erro: $e');

      if (await conexaoRealmenteCaiu()) {
        await _closeConnSilently();
        _setConnectionState(false);
        _iniciarReconexaoSilenciosa();

        final conn2 = await _garantirConexao();
        if (conn2 != null) {
          try {
            await conn2.transactional((ctx) async {
              for (var sql in queries) {
                if (sql.trim().isNotEmpty) {
                  await ctx.execute(sql);
                }
              }
            });
            return 'sucesso';
          } catch (_) {}
        }
      }

      return 'erro';
    }
  }

  /// Alias para [transaction] sugerido pelo usuário.
  Future<String> safeQuery(List<String> queries) async {
    return await transaction(queries);
  }

  // LOADING DE RECONEXÃO (UI)

  static bool get _rotaBloqueada {
    final rota = Get.currentRoute;
    return rota == '/inicial' || rota == '/configuracoes' || rota == '/splash';
  }

  /// Exibe o dialog de reconexão.
  ///
  /// Garantias:
  /// - Nunca duplica (guarda por _exibindoCarregamento + isDialogOpen)
  /// - Nunca aparece em rotas de configuração/splash
  /// - Race condition tratada: valida estado *no momento* do show()
  /// - Não aparece durante período de graça (chamador já garante isso)
  static void _mostrarLoadingReconexao() {
    // Guarda já exibindo com dialog visível → não duplica
    if (_exibindoCarregamento && (Get.isDialogOpen ?? false)) return;

    // Rotas onde o loading não faz sentido
    if (_rotaBloqueada) {
      debugPrint('[Connection] Loading bloqueado na rota: ${Get.currentRoute}');
      return;
    }

    _exibindoCarregamento = true;

    void show() {
      // Validações no momento exato do frame (race condition protection)
      if (!_exibindoCarregamento) return; // reconectou antes do frame
      if (Get.isDialogOpen ?? false)
        return; // dialog já aberto por outra chamada
      if (_rotaBloqueada) {
        _exibindoCarregamento = false;
        return;
      }
      // Se reconectou entre a chamada e o frame, não exibe loading
      if (_conn != null && _conn!.connected && _isConnected.value) {
        _exibindoCarregamento = false;
        return;
      }

      Get.dialog(
        PopScope(
          canPop: false,
          child: Center(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                const CircularProgressIndicator(
                  valueColor: AlwaysStoppedAnimation<Color>(Colors.white),
                ),
                const SizedBox(height: 15),
                const Material(
                  color: Colors.transparent,
                  child: Text(
                    'Reconectando ao servidor...',
                    style: TextStyle(
                      color: Colors.white,
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
                const SizedBox(height: 25),
                IconButton(
                  onPressed: () async {
                    final bool ok = await conectarBanconoSalvar();
                    if (ok) _fecharLoadingReconexao();
                  },
                  icon: const Icon(Icons.refresh, color: Colors.white),
                ),
              ],
            ),
          ),
        ),
        barrierDismissible: false,
        routeSettings: const RouteSettings(name: _loadingDialogRoute),
      );
    }

    // Agenda no frame correto para evitar "setState during build"
    if (SchedulerBinding.instance.schedulerPhase == SchedulerPhase.idle) {
      show();
    } else {
      SchedulerBinding.instance.addPostFrameCallback((_) => show());
    }
  }

  static void _fecharLoadingReconexao() {
    if (!_exibindoCarregamento) return;
    if (Get.isDialogOpen ?? false) Get.back();
    _exibindoCarregamento = false;
  }

  // HELPERS INTERNOS

  static Future<bool> _tryConnect(String host) async {
    if (host == ipTeste || host == ipTeste2) {
      return await conexaoTeste(host);
    } else {
      return await conexaoProducao(host);
    }
  }

  static Future<bool> conexaoProducao(String host) async {
    try {
      await _closeConnSilently();

      // iOS ISSUE: createConnection() sem timeout trava INFINITAMENTE
      // se o host não responde (firewall, IP errado, permissão negada).
      // Timeout de 8s na criação + 10s no connect = 18s total máximo.
      _conn = await MySQLConnection.createConnection(
        host: host,
        port: int.parse(dotenv.get('DB_PORT', fallback: '3306')),
        userName: dotenv.get('DB_USER', fallback: 'root'),
        password: dotenv.get('DB_PASSWORD', fallback: ''),
        databaseName: dotenv.get('DB_NAME', fallback: 'undercontrol'),
        secure: false,
      ).timeout(
        const Duration(seconds: 8),
        onTimeout: () {
          debugPrint('[Connection] ⏱ createConnection() timeout — host: $host');
          throw TimeoutException('createConnection timeout', const Duration(seconds: 8));
        },
      );

      // connect() com seu próprio timeout (iOS pode travar aqui também)
      await _conn!.connect().timeout(
        const Duration(seconds: 10),
        onTimeout: () {
          debugPrint('[Connection] ⏱ connect() timeout — host: $host');
          throw TimeoutException('connect() timeout', const Duration(seconds: 10));
        },
      );

      debugPrint('[Connection] Produção conectada: $host');
      return true;
    } on TimeoutException catch (e) {
      // Timeout é o erro mais comum no iOS com permissão de rede negada
      debugPrint('[Connection] ⏱ Timeout ao conectar ($host): $e');
      await _closeConnSilently();
      return false;
    } on SocketException catch (e) {
      // SocketException no iOS indica: permissão de rede local negada,
      // IP inválido, host inacessível ou porta fechada.
      debugPrint('[Connection] 🔌 SocketException ($host): ${e.message} | OS: ${e.osError}');
      await _closeConnSilently();
      return false;
    } catch (e) {
      await _closeConnSilently();
      return false;
    }
  }

  static Future<bool> conexaoTeste(String host) async {
    try {
      await _closeConnSilently();

      _conn = await MySQLConnection.createConnection(
        host: 'mysql.focusnetwork.com.br',
        port: int.parse(dotenv.get('DB_PORT_TESTE')),
        userName: dotenv.get('DB_USER_TESTE'),
        password: dotenv.get('DB_PASSWORD_TESTE'),
        databaseName: dotenv.get('DB_NAME_TESTE'),
        secure: false,
      );

      await _conn!.connect().timeout(const Duration(seconds: 20));
      final result = await _conn!.execute('SELECT 1;');

      if (result.isNotEmpty) {
        debugPrint('[Connection] Teste conectada.');
        return true;
      }

      await _closeConnSilently();
      return false;
    } catch (e) {
      debugPrint('[Connection] Erro teste: $e');
      await _closeConnSilently();
      return false;
    }
  }

  static void _setConnectionState(bool state) {
    _isConnected.value = state;
    isConnected.value = state;
  }

  static Future<void> _closeConnSilently() async {
    _keepAliveTimer?.cancel();
    try {
      await _conn?.close();
    } catch (_) {}
    _conn = null;
  }

