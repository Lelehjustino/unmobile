 static Future<String?> discoverServer() async {
    const int portaOuvir = 30078;
    const String chaveEsperada = "UnderControl Engine";

    debugPrint('[discoverServer] Iniciando busca UDP por servidor...');

    // iOS/Android podem bloquear UDP broadcast — tentamos IPv4 e IPv6
    for (final bindAddr in [InternetAddress.anyIPv4, InternetAddress.anyIPv6]) {
      RawDatagramSocket? socket;
      try {
        socket = await RawDatagramSocket.bind(
          bindAddr,
          portaOuvir,
          reuseAddress: true, // coloquei true
        ).timeout(const Duration(seconds: 3));

        socket.broadcastEnabled = true;
        debugPrint('[discoverServer] Escutando UDP em ${bindAddr.address}...');

        await for (RawSocketEvent event in socket.timeout(
          const Duration(seconds: 10), // Aumentado para 10s para maior tolerância
        )) {
          if (event == RawSocketEvent.read) {
            final datagram = socket.receive();
            if (datagram == null) continue;

            final msg = utf8.decode(datagram.data, allowMalformed: true).trim();
            debugPrint('[discoverServer] UDP Recebido de ${datagram.address.address}: "$msg"');

            // Verificação flexível: se contém a chave, tentamos extrair o IP
            if (msg.contains(chaveEsperada)) {
              String ipEncontrado = '';
              final split = msg.split('|');
              
              if (split.length >= 2) {
                ipEncontrado = split[1].trim();
              }
              
              // FALLBACK: Se o IP na mensagem estiver vazio ou malformatado, 
              // usamos o IP de quem enviou o pacote UDP (muito mais seguro).
              if (ipEncontrado.isEmpty || ipEncontrado.split('.').length < 3) {
                ipEncontrado = datagram.address.address;
                debugPrint('[discoverServer] IP não extraído ou inválido. Usando origem: $ipEncontrado');
              }

              if (ipEncontrado.isNotEmpty) {
                debugPrint('[discoverServer] Servidor localizado com sucesso: $ipEncontrado');
                socket.close();
                return ipEncontrado;
              }
            }
          }
        }
      } on SocketException catch (e) {
        // iOS com frequência lança SocketException para UDP em rede local
        debugPrint('[discoverServer] SocketException (${bindAddr.address}): ${e.message}');
      } on TimeoutException {
        debugPrint('[discoverServer] Timeout (${bindAddr.address})');
      } catch (e) {
        debugPrint('[discoverServer] Erro (${bindAddr.address}): $e');
      } finally {
        socket?.close();
      }
    }

    return null;
  }
}

// LIFECYCLE HANDLER - onde fica os estados do app (aberto/fechado) e os handlers 

class _LifecycleHandler with WidgetsBindingObserver {
  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    debugPrint('[Lifecycle] Estado: $state');
    switch (state) {
      case AppLifecycleState.paused:
      case AppLifecycleState.inactive:
        Connection._appFoiParaBackground();
        break;

      case AppLifecycleState.resumed:
        Connection._appVoltouDoBackground();
        break;

      case AppLifecycleState.detached:
        // CORRIGIDO: 'detached' = app encerrando/inicializando.
        // Antes chamava _appVoltouDoBackground() aqui — causava
        // reconexão falsa na inicialização do app no iOS.
        debugPrint('[Lifecycle] App detached — ignorado.');
        break;

      case AppLifecycleState.hidden:
        // iOS 17+ (Stage Manager, split view)
        Connection._appFoiParaBackground();
        break;
    }
  }
}
